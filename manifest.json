{
  "manifest_version": 3,
  "name": "Nintendo Switch Online WebApp",
  "version": "1.0.0",
  "description": "Local zero-worker companion & CORS engine for Nintendo Switch Online WebApp.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "https://accounts.nintendo.com/*",
    "https://api.accounts.nintendo.com/*",
    "https://*.nintendo.net/*",
    "https://*.srv.nintendo.net/*",
    "https://*.nintendo.com/*",
    "https://nxapi-znca-api.fancy.org.uk/*",
    "https://nxapi-auth.fancy.org.uk/*",
    "https://*.fancy.org.uk/*",
    "https://nso-worker-backend.diogoenes0.workers.dev/*",
    "https://*.workers.dev/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nintendo Switch Online WebApp",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.nintendo.net/*",
        "https://*.srv.nintendo.net/*",
        "https://*.nintendo.com/*"
      ],
      "js": [
        "bridge-content-script.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://dycool.github.io/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bridge-content-script.js"
      ],
      "matches": [
        "https://dycool.github.io/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ]
    }
  ],
  "key": ""
}